<mxfile host="app.diagrams.net" compressed="false"><diagram id="origen-actual" name="Flujo actual de originación"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="251" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="aliados" value="&lt;span style=&quot;font-size:11px;font-weight:700;color:#375651&quot;&gt;ENTRADA&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;font-weight:700;color:#102e31&quot;&gt;Aliados comerciales&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#375651&quot;&gt;Cuatro archivos semanales&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#375651&quot;&gt;con datos de prospectos.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#ebf5ee;strokeColor=#b6d2bf;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="22" y="108" width="208" height="100" as="geometry" /></mxCell><mxCell id="riesgo" value="&lt;span style=&quot;font-size:11px;font-weight:700;color:#375651&quot;&gt;VALIDACIÓN&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;font-weight:700;color:#102e31&quot;&gt;Riesgo + CRM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#375651&quot;&gt;Aplica reglas y registra&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#375651&quot;&gt;a los prospectos aceptados.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#ebf5ee;strokeColor=#b6d2bf;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="270" y="108" width="208" height="100" as="geometry" /></mxCell><mxCell id="credito" value="&lt;span style=&quot;font-size:11px;font-weight:700;color:#375651&quot;&gt;EVALUACIÓN&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;font-weight:700;color:#102e31&quot;&gt;Estudio de crédito&lt;/span&gt;&lt;br